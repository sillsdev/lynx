{
  "name": "@sillsdev/lynx-deep-agent",
  "version": "0.0.0",
  "description": "LLM agent integration for Lynx using deepagents",
  "type": "module",
  "types": "./dist/index.d.mts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "SIL Global",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sillsdev/lynx.git",
    "directory": "packages/deep-agent"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@sillsdev/lynx": "*",
    "deepagents": "^1.9.0",
    "rxjs": "^7.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tsdown-config": "*",
    "@repo/typescript-config": "*",
    "eslint": "^9.39.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest-mock-extended": "^3.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
