{
  "name": "@sillsdev/lynx-vscode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "author": "SIL Global",
  "license": "MIT",
  "description": "",
  "engines": {
    "vscode": "^1.93.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions"
  ],
  "activationEvents": [
    "onLanguage:usfm"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "lynx.chatParticipant",
        "fullName": "Lynx",
        "name": "lynx",
        "description": "Bible translation assistant that helps with translation quality checks, formatting, and diagnostics.",
        "isSticky": true
      }
    ],
    "languages": [
      {
        "id": "usfm",
        "extensions": [
          ".SFM",
          ".sfm",
          ".usfm",
          ".USFM"
        ],
        "aliases": [
          "USFM"
        ]
      }
    ],
    "configuration": {
      "title": "Lynx",
      "properties": {
        "lynx.diagnosticDismissalFilePath": {
          "type": "string",
          "default": "",
          "description": "Path to a JSON file for persisting dismissed diagnostics. If empty, dismissals are stored in memory only."
        },
        "lynx.agent.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Lynx agent and chat participant."
        },
        "lynx.agent.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "google-genai"
          ],
          "default": "anthropic",
          "description": "LLM provider for the Lynx agent."
        },
        "lynx.agent.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier for the Lynx agent. If empty, a sensible default is used based on the provider."
        },
        "lynx.agent.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the Lynx agent. If empty, falls back to the provider's environment variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, or GOOGLE_API_KEY)."
        }
      }
    }
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@sillsdev/lynx": "*",
    "@sillsdev/lynx-examples": "*",
    "@sillsdev/lynx-punctuation-checker": "*",
    "@sillsdev/lynx-react-agent": "*",
    "@sillsdev/lynx-usfm": "*",
    "langchain": "^1.3.1",
    "rxjs": "^7.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tsdown-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.93.0",
    "eslint": "^9.39.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
